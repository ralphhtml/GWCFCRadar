# Copy this file to .env and fill in your own values.
#
# Get this from discord.com/developers/applications: create an application,
# copy its Application ID from General Information.
DISCORD_PRESENCE_CLIENT_ID=

# Only needs changing if 32473 is already taken by something else on your
# machine.
PRESENCE_BRIDGE_PORT=32473

# The Rich Presence Art Asset key you gave the uploaded logo under
# Rich Presence > Art Assets in the developer portal. Only needs changing
# if you named it something other than "gwcfc" when you uploaded it.
DISCORD_PRESENCE_IMAGE_KEY=gwcfc
